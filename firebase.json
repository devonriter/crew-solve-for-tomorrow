{
  "hosting": {
    "public": ".",
    "ignore": [
      ".github/**",
      "CLAUDE.md",
      "README.md",
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
